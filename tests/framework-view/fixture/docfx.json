{
  "metadata": [
    {
      "src": [{ "src": "..", "files": ["Runtime/Runtime.csproj"] }],
      "dest": "api/runtime",
      "memberLayout": "separatePages"
    },
    {
      "src": [{ "src": "..", "files": ["Utilities/Utilities.csproj"] }],
      "dest": "api/utilities",
      "memberLayout": "separatePages"
    },
    {
      "src": [{ "src": "..", "files": ["ModernApi/ModernApi.csproj"] }],
      "dest": "api/modern",
      "memberLayout": "separatePages"
    },
    {
      "src": [{ "src": "..", "files": ["StandardApi/StandardApi.csproj"] }],
      "dest": "api/standard",
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [{ "files": ["api/**/*.yml", "index.md", "toc.yml"] }],
    "globalMetadata": {
      "_appName": "Framework Fixture",
      "_enableSearch": true,
      "_disableContribution": true
    },
    "template": ["default", "modern", "templates/ms-style"],
    "dest": "_site"
  }
}
